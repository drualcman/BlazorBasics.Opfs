<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishTrimmed>false</PublishTrimmed>
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Src\BlazorBasics.Opfs\BlazorBasics.Opfs.csproj" />
    <ProjectReference Include="..\BlazorBasics.Opfs.ContractTests\BlazorBasics.Opfs.ContractTests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>browser</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="BlazorBasics.Opfs.Abstractions" />
    <Using Include="BlazorBasics.Opfs.ContractTests" />
    <Using Include="BlazorBasics.Opfs.Exceptions" />
    <Using Include="BlazorBasics.Opfs.Models" />
    <Using Include="BlazorBasics.Opfs.Services" />
  </ItemGroup>

</Project>
